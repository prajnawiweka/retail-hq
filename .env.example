# Salin file ini menjadi .env lalu isi. Jangan commit .env ke GitHub.

# Google Cloud
GCP_PROJECT_ID=isi-project-id-kamu
BQ_LOCATION=asia-southeast2
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_MART=mart

# Mode biaya: free (sandbox / free tier) atau paid. Upgrade cukup ganti baris ini.
BILLING_MODE=free

# Tahap 3 (agent). API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=          # kosong = gemini-3.5-flash (cadangan otomatis: gemini-flash-lite-latest)
# Bot Telegram: buat lewat @BotFather. Kirim /id ke bot untuk melihat user id kamu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=   # contoh 12345678,87654321; kosong = semua orang bisa bertanya
